{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.title' | t }} &ndash; {{ shop.name }}</title>
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="customer text-center">
      <span class="site-header__logo-text" style="font-size:2rem">{{ shop.name }}</span>
      <h1 class="h2" style="margin-top:2rem">{{ 'gift_cards.title' | t }}</h1>
      <p class="price--large" style="font-size:2.5rem">{{ gift_card.balance | money }}</p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="subtle">{{ 'gift_cards.value' | t: value: gift_card.initial_value | money }}</p>
      {%- endif -%}
      {%- if gift_card.expired -%}
        <p class="badge badge--soldout">{{ 'gift_cards.expired' | t }}</p>
      {%- elsif gift_card.enabled == false -%}
        <p class="badge badge--soldout">{{ 'gift_cards.disabled' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        <p class="subtle">{{ 'gift_cards.expires_on' | t: expires_on: gift_card.expires_on | date: '%B %e, %Y' }}</p>
      {%- endif -%}
      <div class="field" style="margin-top:2rem">
        <label for="GiftCardCode">{{ 'gift_cards.code' | t }}</label>
        <input class="input text-center" id="GiftCardCode" type="text" value="{{ gift_card.code | format_code }}" readonly onfocus="this.select()">
      </div>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:flex;justify-content:center;margin:1.5rem 0"></div>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy" style="margin:0 auto 1rem"></a>
      {%- endif -%}
      <div style="display:flex;gap:.75rem;justify-content:center">
        <a href="{{ shop.url }}" class="button button--primary">{{ 'gift_cards.shop_now' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.print' | t }}</button>
      </div>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
