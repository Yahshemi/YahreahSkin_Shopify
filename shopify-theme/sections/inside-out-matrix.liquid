<section class="py-16 sm:py-20 bg-white border-b border-[#E2DBD0]/60" id="matrix">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <span class="text-xs uppercase tracking-widest font-bold text-[#7C9F8A] bg-[#EEF4F0] px-3.5 py-1 rounded-full border border-[#7C9F8A]/30">
        The Dual-Action Philosophy
      </span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#212925]">
        Why Single-Method Skincare Fails
      </h2>
      <p class="text-sm sm:text-base text-[#5C6760] font-sans">
        Topical creams only reach the epidermis. Oral supplements alone take weeks to surface. Yahreah Skin synchronizes deep cellular peptide synthesis with surface lipid barrier fortification.
      </p>
    </div>

    <!-- Dual Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      
      <!-- Inside (Ingestibles) Card -->
      <div class="bg-[#FAF8F3] border border-[#E2DBD0] rounded-3xl p-6 sm:p-8 relative overflow-hidden group hover:border-[#7C9F8A] transition-all">
        <div class="w-12 h-12 rounded-2xl bg-[#EEF4F0] text-[#7C9F8A] flex items-center justify-center text-xl font-bold mb-4">
          🧪
        </div>
        <span class="text-xs uppercase tracking-wider font-bold text-[#7C9F8A]">Target: Dermis & Cellular Matrix</span>
        <h3 class="font-serif text-2xl font-bold text-[#212925] mt-1 mb-3">INSIDE (Ingestible Peptides)</h3>
        <p class="text-sm text-[#5C6760] leading-relaxed mb-6">
          Micro-milled wild marine collagen Type I & III, paired with fulvic ionic trace minerals and low-molecular hyaluronic acid to stimulate fibroblast collagen generation from within.
        </p>
        <ul class="space-y-2.5 text-xs text-[#212925] font-medium">
          <li class="flex items-center gap-2">✔ 98% Bio-availability for systemic delivery</li>
          <li class="flex items-center gap-2">✔ Restores deep dermal density & spring</li>
          <li class="flex items-center gap-2">✔ 72+ Ionic trace minerals for cellular energy</li>
        </ul>
      </div>

      <!-- Outside (Topicals) Card -->
      <div class="bg-[#FAF8F3] border border-[#E2DBD0] rounded-3xl p-6 sm:p-8 relative overflow-hidden group hover:border-[#A9C3C2] transition-all">
        <div class="w-12 h-12 rounded-2xl bg-[#E8F1F1] text-[#3B5A59] flex items-center justify-center text-xl font-bold mb-4">
          💧
        </div>
        <span class="text-xs uppercase tracking-wider font-bold text-[#3B5A59]">Target: Epidermis & Lipid Mantle</span>
        <h3 class="font-serif text-2xl font-bold text-[#212925] mt-1 mb-3">OUTSIDE (Topical Serums)</h3>
        <p class="text-sm text-[#5C6760] leading-relaxed mb-6">
          Phyto-ceramide complexes, olive-derived squalane, and cold-pressed organic botanicals seal transepidermal water loss and soothe environmental inflammation.
        </p>
        <ul class="space-y-2.5 text-xs text-[#212925] font-medium">
          <li class="flex items-center gap-2">✔ Reinforces stratum corneum moisture lock</li>
          <li class="flex items-center gap-2">✔ Calms active redness & reactive flare-ups</li>
          <li class="flex items-center gap-2">✔ Non-comedogenic 100% pure botanical lipids</li>
        </ul>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Inside Out Matrix",
  "settings": []
}
{% endschema %}
