{% comment %}
  Hero Slider Section for Yahreah Skin - Shopify OS 2.0
{% endcomment %}

<div class="relative overflow-hidden bg-gradient-to-b from-[#F5F1E8] via-[#FAF8F3] to-[#FAF8F3] py-10 sm:py-14 md:py-20 border-b border-[#E2DBD0]/60" data-section-id="{{ section.id }}" data-section-type="hero-slider">
  
  <!-- Ambient glow blobs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#7C9F8A]/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-24 w-96 h-96 bg-[#A9C3C2]/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Slider Indicator Controls -->
    <div class="flex items-center justify-between mb-4 text-xs text-[#5C6760] font-sans">
      <div class="flex items-center gap-2">
        <span class="font-serif font-bold text-[#7C9F8A] text-sm js-current-slide-num">01</span>
        <span class="text-[#B7A79D]">/</span>
        <span class="text-[#5C6760]">0{{ section.blocks.size }}</span>
        <span class="hidden sm:inline-block text-[#B7A79D] mx-1">•</span>
        <span class="hidden sm:inline-block font-medium text-[#212925] js-slide-badge-label">Holistic Inside-Out Skincare</span>
      </div>

      <div class="flex items-center gap-3">
        <button type="button" class="js-toggle-autoplay inline-flex items-center gap-1.5 text-xs text-[#5C6760] hover:text-[#212925] bg-white/80 hover:bg-white px-2.5 py-1 rounded-full border border-[#E2DBD0] transition-colors">
          <svg class="w-3 h-3 text-[#7C9F8A]" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          <span class="hidden sm:inline">Autoplay</span>
        </button>

        <div class="flex items-center gap-1">
          <button type="button" class="js-prev-slide w-8 h-8 rounded-full bg-white/90 hover:bg-white border border-[#E2DBD0] flex items-center justify-center text-[#212925] shadow-sm hover:shadow-md transition-all active:scale-95" aria-label="Previous Slide">
            ‹
          </button>
          <button type="button" class="js-next-slide w-8 h-8 rounded-full bg-white/90 hover:bg-white border border-[#E2DBD0] flex items-center justify-center text-[#212925] shadow-sm hover:shadow-md transition-all active:scale-95" aria-label="Next Slide">
            ›
          </button>
        </div>
      </div>
    </div>

    <!-- Slides Container -->
    <div class="hero-slides-wrapper relative">
      {% for block in section.blocks %}
        <div class="hero-slide-item {% unless forloop.first %}hidden{% endunless %} transition-opacity duration-500" data-index="{{ forloop.index0 }}" data-badge="{{ block.settings.badge | escape }}">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            
            <!-- Left Text Column -->
            <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-center lg:text-left">
              <div class="inline-flex items-center gap-2 bg-[#EEF4F0] border border-[#7C9F8A]/30 px-4 py-1.5 rounded-full text-xs font-semibold text-[#2A3B30]">
                <span class="uppercase tracking-wider">{{ block.settings.badge }}</span>
              </div>

              <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-[#212925] leading-[1.15] tracking-tight">
                {{ block.settings.headline_main }} <br class="hidden sm:inline">
                <span class="text-[#7C9F8A] italic font-normal">{{ block.settings.headline_highlight }}</span>
              </h1>

              <p class="text-base sm:text-lg text-[#5C6760] font-sans leading-relaxed max-w-2xl mx-auto lg:mx-0">
                {{ block.settings.subheadline }}
              </p>

              <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
                <a href="{{ block.settings.button_1_link }}" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#7C9F8A] hover:bg-[#6a8c78] text-white text-base font-semibold px-8 py-3.5 rounded-full shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-0.5">
                  <span>{{ block.settings.button_1_text }}</span>
                  <span class="ml-1">→</span>
                </a>

                <a href="{{ block.settings.button_2_link }}" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-[#F5F1E8] text-[#212925] border border-[#E2DBD0] text-base font-semibold px-7 py-3.5 rounded-full transition-all">
                  <span>{{ block.settings.button_2_text }}</span>
                </a>
              </div>

              <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-[#5C6760]">
                <div class="flex items-center gap-1.5">
                  <div class="text-amber-500 font-bold">★★★★★</div>
                  <span class="font-semibold text-[#212925]">4.9/5</span>
                  <span>(1,200+ Verified Buyers)</span>
                </div>
                <div class="flex items-center gap-2 text-[#2A3B30] font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#7C9F8A]"></span>
                  <span>100% USA Formulated</span>
                </div>
              </div>
            </div>

            <!-- Right Image Frame Column -->
            <div class="lg:col-span-5 relative">
              <div class="relative mx-auto max-w-md lg:max-w-none">
                <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white aspect-[4/5] bg-[#E8F1F1] group">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.tag | escape }}" class="w-full h-full object-cover">
                  {% else %}
                    <img src="https://images.unsplash.com/photo-1512290900673-70020192934b?q=80&w=1000&auto=format&fit=crop" alt="Yahreah Synergy" class="w-full h-full object-cover">
                  {% endif %}

                  <div class="absolute inset-x-4 bottom-4 bg-white/92 backdrop-blur-md p-3.5 sm:p-4 rounded-2xl border border-[#E2DBD0] shadow-lg">
                    <div class="flex items-center justify-between gap-2">
                      <div>
                        <span class="text-[10px] uppercase font-bold tracking-widest text-[#7C9F8A] block">
                          {{ block.settings.tag }}
                        </span>
                        <p class="text-xs font-serif font-semibold text-[#212925] truncate">
                          {{ block.settings.tag_sub }}
                        </p>
                      </div>
                      {% if block.settings.discount_badge != blank %}
                        <span class="bg-[#7C9F8A] text-white text-[11px] font-bold px-2.5 py-1 rounded-full shrink-0">
                          {{ block.settings.discount_badge }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </div>

                <!-- Floating Badges -->
                <div class="absolute -top-4 -left-4 bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-2xl border border-[#E2DBD0] shadow-xl flex items-center gap-2.5 z-20">
                  <div class="w-8 h-8 rounded-full bg-[#EEF4F0] flex items-center justify-center text-[#7C9F8A] font-bold text-xs">🌿</div>
                  <div>
                    <p class="text-xs font-bold text-[#212925]">Cellular Vitality</p>
                    <p class="text-[10px] text-[#5C6760]">Deep collagen synthesis</p>
                  </div>
                </div>

                <div class="absolute -bottom-4 -right-4 bg-white/95 backdrop-blur-md px-3.5 py-2.5 rounded-2xl border border-[#E2DBD0] shadow-xl flex items-center gap-2.5 z-20">
                  <div class="w-8 h-8 rounded-full bg-[#E8F1F1] flex items-center justify-center text-[#3B5A59] font-bold text-xs">✨</div>
                  <div>
                    <p class="text-xs font-bold text-[#212925]">Barrier Fortified</p>
                    <p class="text-[10px] text-[#5C6760]">88% less surface redness</p>
                  </div>
                </div>

              </div>
            </div>

          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Indicator Dots -->
    <div class="mt-8 flex items-center justify-center gap-2.5 js-slide-dots">
      {% for block in section.blocks %}
        <button type="button" class="js-dot-btn h-2.5 rounded-full transition-all duration-300 {% if forloop.first %}w-10 bg-[#7C9F8A]{% else %}w-2.5 bg-[#E2DBD0]{% endif %}" data-target="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {% endfor %}
    </div>

    <!-- Brand Pillars Bar -->
    <div class="mt-12 pt-8 border-t border-[#E2DBD0]/60 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
      <div class="flex flex-col items-center p-3 rounded-2xl bg-white/60 alabaster-shadow border border-[#E2DBD0]/40">
        <span class="text-lg mb-1">🏆</span>
        <h4 class="font-serif font-semibold text-sm text-[#212925]">USA Crafted</h4>
        <p class="text-xs text-[#5C6760] mt-0.5">Meticulously formulated in CGMP labs</p>
      </div>
      <div class="flex flex-col items-center p-3 rounded-2xl bg-white/60 alabaster-shadow border border-[#E2DBD0]/40">
        <span class="text-lg mb-1">🌱</span>
        <h4 class="font-serif font-semibold text-sm text-[#212925]">100% Transparent</h4>
        <p class="text-xs text-[#5C6760] mt-0.5">Bio-available active ingredients</p>
      </div>
      <div class="flex flex-col items-center p-3 rounded-2xl bg-white/60 alabaster-shadow border border-[#E2DBD0]/40">
        <span class="text-lg mb-1">💖</span>
        <h4 class="font-serif font-semibold text-sm text-[#212925]">As Within, So Without</h4>
        <p class="text-xs text-[#5C6760] mt-0.5">Targeted internal & topical synergy</p>
      </div>
      <div class="flex flex-col items-center p-3 rounded-2xl bg-white/60 alabaster-shadow border border-[#E2DBD0]/40">
        <span class="text-lg mb-1">🔬</span>
        <h4 class="font-serif font-semibold text-sm text-[#212925]">Clinical Rigor</h4>
        <p class="text-xs text-[#5C6760] mt-0.5">Proven efficacy & non-comedogenic</p>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Hero Showcase Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge Tagline",
          "default": "Holistic Inside-Out Skincare"
        },
        {
          "type": "text",
          "id": "headline_main",
          "label": "Headline Main",
          "default": "As Within, "
        },
        {
          "type": "text",
          "id": "headline_highlight",
          "label": "Headline Highlight",
          "default": "So Without."
        },
        {
          "type": "textarea",
          "id": "subheadline",
          "label": "Subheadline Text",
          "default": "True skin longevity pairs wild marine collagen & 72+ bio-available trace minerals with botanical ceramide serums."
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Primary Button Text",
          "default": "Take Routine Diagnostic Quiz"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Secondary Button Text",
          "default": "Shop Radiance Systems"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Secondary Button Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Image Tag Overlay",
          "default": "Dual Synergy System"
        },
        {
          "type": "text",
          "id": "tag_sub",
          "label": "Image Tag Subtext",
          "default": "Marine Collagen + Squalane Serum Duo"
        },
        {
          "type": "text",
          "id": "discount_badge",
          "label": "Discount / Offer Badge",
          "default": "Save 20%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Showcase Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
