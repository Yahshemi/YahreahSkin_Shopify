<section class="py-16 sm:py-20 bg-[#EEF4F0] border-b border-[#7C9F8A]/30 relative overflow-hidden" id="quiz">
  <div class="max-w-4xl mx-auto px-4 text-center relative z-10 space-y-6">
    <span class="inline-block bg-white text-[#2A3B30] text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-[#7C9F8A]/40">
      Interactive Routine Diagnostic
    </span>

    <h2 class="font-serif text-3xl sm:text-5xl font-bold text-[#212925]">
      Find Your Custom Inside-Out Formula
    </h2>

    <p class="text-sm sm:text-base text-[#5C6760] font-sans max-w-2xl mx-auto">
      Answer 4 quick questions regarding your skin concerns, stress levels, and lifestyle to unlock your personalized Yahreah Skin routine recommendation.
    </p>

    <div class="pt-4">
      <button type="button" class="js-start-quiz-modal bg-[#7C9F8A] hover:bg-[#6a8c78] text-white font-semibold text-base px-9 py-4 rounded-full shadow-lg hover:shadow-xl transition-all inline-flex items-center gap-2">
        <span>✨ Start 60-Second Skin Diagnostic</span>
        <span>→</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skin Quiz Banner",
  "settings": []
}
{% endschema %}
