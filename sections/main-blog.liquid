<div class="page-width">
  <div class="page-header">
    <span class="eyebrow">Journal</span>
    <h1>{{ blog.title | escape }}</h1>
  </div>
  {%- paginate blog.articles by 9 -%}
    <div class="grid grid--3 grid--mobile-1 page-content">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card reveal">
          <div class="article-card__media">
            {%- if article.image -%}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: format: 'month_day_year' }}</time>
          <h2 class="h3" style="margin:0">{{ article.title | escape }}</h2>
          <p class="subtle" style="margin:0">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
