<div class="customer">
  <h1>{{ 'customer.reset_password' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input class="input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password"></div>
    <div class="field"><label for="ResetConfirm">{{ 'customer.confirm_password' | t }}</label><input class="input" type="password" name="customer[password_confirmation]" id="ResetConfirm" autocomplete="new-password"></div>
    <button type="submit" class="button button--primary button--full">{{ 'customer.reset_password' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
