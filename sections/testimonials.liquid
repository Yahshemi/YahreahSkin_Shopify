{%- if section.blocks.size > 0 -%}
<section class="section section--surface">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="grid grid--3 grid--mobile-1">
      {%- for block in section.blocks -%}
        <figure class="testimonial reveal" style="margin:0" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <span class="rating"><span class="rating__stars" style="--pct: {{ block.settings.rating | times: 20 }}%" aria-hidden="true"></span><span class="visually-hidden">{{ 'accessibility.star_rating' | t: rating: block.settings.rating, max: 5 }}</span></span>
          {%- endif -%}
          <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption class="testimonial__meta">
            <strong>{{ block.settings.author | escape }}</strong>
            {%- if block.settings.product != blank -%}{{ block.settings.product.title | escape }}{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "paragraph", "content": "Only add real customer quotes you have permission to use. Fake reviews break FTC rules. For product reviews, install a reviews app instead." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Real results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 9,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Name (e.g. Maria R.)" },
        { "type": "range", "id": "rating", "label": "Stars (0 hides)", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "product", "id": "product", "label": "Product used" }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials" }]
}
{% endschema %}
