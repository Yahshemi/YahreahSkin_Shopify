<div class="drawer" id="CartDrawer" aria-hidden="true" data-count="{{ cart.item_count }}">
  <div class="drawer__overlay" data-cart-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div data-drawer-inner style="display:contents">
      <div class="drawer__head">
        <h2 id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
        <button type="button" class="icon-button" data-cart-close aria-label="{{ 'general.close' | t }}" data-autofocus>{% render 'icon', name: 'close' %}</button>
      </div>

      <div class="drawer__body">
        {%- if cart.item_count > 0 -%}
          {% render 'shipping-bar' %}
          {% render 'cart-line-items' %}
        {%- else -%}
          <div class="drawer__empty">
            <p class="h3">{{ 'cart.empty' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button button--primary" style="margin-top:1rem">{{ 'general.continue_shopping' | t }}</a>
          </div>
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="drawer__foot">
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="cart-summary__row" style="font-size:.9375rem;font-weight:400">
              <span>{{ discount.title | escape }}</span><span>&minus;{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
          <div class="cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <small>{{ 'cart.taxes_and_shipping' | t }}</small>
          <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
            <button type="submit" name="checkout" class="button button--primary button--full">{{ 'cart.checkout' | t }}</button>
          </form>
          <a href="{{ routes.cart_url }}" class="link" style="display:block;text-align:center;margin-top:.75rem;font-size:.875rem">{{ 'cart.view_cart' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
