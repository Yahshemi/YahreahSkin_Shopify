{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div>{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="collection-tabs" aria-label="Shop by category">
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            <a href="{{ block.settings.collection.url }}" class="pill" {{ block.shopify_attributes }}>{{ block.settings.label | default: block.settings.collection.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="grid grid--4">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card">
            <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="card__body">
              <h3 class="card__title">Product name</h3>
              <p class="card__tagline">Pick a collection in the theme editor to show real products.</p>
              <div class="card__footer"><div class="price">$0.00</div></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank and collection.products_count > limit -%}
      <div class="section-footer">
        <a href="{{ collection.url }}" class="button button--secondary">{{ 'general.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The Yahreah Catalog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated inside-out collection" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Supplements for the inside, topicals for the outside, and systems that pair them.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Alabaster background", "default": false }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category link",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
