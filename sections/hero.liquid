<section class="hero" data-hero data-autoplay="{% if section.settings.autoplay %}{{ section.settings.autoplay_speed }}{% else %}0{% endif %}" aria-roledescription="carousel">
  <div class="page-width">
    <div class="hero__slides">
      {%- for block in section.blocks -%}
        <div class="hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}">
          <div class="hero__grid">
            <div class="hero__content">
              {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
              {%- if forloop.first -%}
                <h1>{{ block.settings.heading | escape }}{% if block.settings.heading_accent != blank %} <em>{{ block.settings.heading_accent | escape }}</em>{% endif %}</h1>
              {%- else -%}
                <h2 class="h1">{{ block.settings.heading | escape }}{% if block.settings.heading_accent != blank %} <em>{{ block.settings.heading_accent | escape }}</em>{% endif %}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}<div class="hero__text">{{ block.settings.text }}</div>{%- endif -%}
              <div class="hero__buttons">
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button button--primary">{{ block.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a href="{{ block.settings.button_link_2 }}" class="button button--secondary">{{ block.settings.button_label_2 | escape }}</a>
                {%- endif -%}
              </div>
            </div>

            <div class="hero__media">
              <div class="hero__image">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1400 | image_tag:
                    widths: '600, 900, 1200, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'eager',
                    fetchpriority: 'high',
                    alt: block.settings.image.alt | default: block.settings.heading
                  }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if block.settings.chip_1_title != blank -%}
                <div class="hero__chip hero__chip--1">
                  <span class="hero__chip-dot">{% render 'icon', name: 'leaf' %}</span>
                  <span><strong>{{ block.settings.chip_1_title | escape }}</strong>{{ block.settings.chip_1_text | escape }}</span>
                </div>
              {%- endif -%}
              {%- if block.settings.chip_2_title != blank -%}
                <div class="hero__chip hero__chip--2">
                  <span class="hero__chip-dot">{% render 'icon', name: 'drop' %}</span>
                  <span><strong>{{ block.settings.chip_2_title | escape }}</strong>{{ block.settings.chip_2_text | escape }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="hero__dots">
        {%- for block in section.blocks -%}
          <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Seconds per slide", "min": 4, "max": 12, "step": 1, "default": 7 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Inside-Out Skincare" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "As Within," },
        { "type": "text", "id": "heading_accent", "label": "Heading accent (italic, sage)", "default": "So Without." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Skin care that works from both sides. Ingestible nutrition supports your skin from within, while clean topicals protect and nourish the surface.</p>" },
        { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the system" },
        { "type": "url", "id": "button_link", "label": "Primary button link" },
        { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "Take the skin quiz" },
        { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
        { "type": "header", "content": "Floating chips" },
        { "type": "text", "id": "chip_1_title", "label": "Chip 1 title", "default": "Inside" },
        { "type": "text", "id": "chip_1_text", "label": "Chip 1 text", "default": "Daily nutrition for skin" },
        { "type": "text", "id": "chip_2_title", "label": "Chip 2 title", "default": "Outside" },
        { "type": "text", "id": "chip_2_text", "label": "Chip 2 text", "default": "Barrier-first topicals" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
