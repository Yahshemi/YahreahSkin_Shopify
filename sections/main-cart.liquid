<div class="page-width">
  <div class="page-header" style="padding-bottom:0">
    <h1>{{ 'cart.title' | t }}</h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-page">
      <div>
        {% render 'shipping-bar' %}
        {% render 'cart-line-items' %}
        {%- if section.settings.show_note -%}
          <div class="field" style="margin-top:1.5rem">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" class="textarea" name="note">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}
      </div>

      <aside class="cart-summary">
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-summary__row" style="font-size:.9375rem;font-weight:400">
            <span>{{ discount.title | escape }}</span><span>&minus;{{ discount.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        <div class="cart-summary__row">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span>{{ cart.total_price | money_with_currency }}</span>
        </div>
        <small>{{ 'cart.taxes_and_shipping' | t }}</small>
        <button type="submit" name="checkout" class="button button--primary button--full">{{ 'cart.checkout' | t }}</button>
        {%- if additional_checkout_buttons -%}
          <div style="margin-top:.75rem">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
        <a href="{{ routes.all_products_collection_url }}" class="link" style="display:block;text-align:center;margin-top:1rem;font-size:.875rem">{{ 'general.continue_shopping' | t }}</a>
      </aside>
    </form>
  {%- else -%}
    <div class="empty-state" style="margin: 2rem 0 5rem">
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary" style="margin-top:1rem">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false }
  ]
}
{% endschema %}
