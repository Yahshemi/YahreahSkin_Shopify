<div class="page-width page-width--narrow page-content">
  {%- if section.settings.heading != blank -%}<h2 class="text-center">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  {%- form 'contact', id: 'ContactForm' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="grid grid--2" style="gap:0 1rem">
      <div class="field">
        <label for="ContactName">{{ 'contact.name' | t }}</label>
        <input class="input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactEmail">{{ 'contact.email' | t }} *</label>
        <input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
    </div>
    <div class="field">
      <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
      <input class="input" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div class="field">
      <label for="ContactBody">{{ 'contact.message' | t }}</label>
      <textarea class="textarea" id="ContactBody" name="contact[body]">{{ form.body }}</textarea>
    </div>
    <button type="submit" class="button button--primary">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" }],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
