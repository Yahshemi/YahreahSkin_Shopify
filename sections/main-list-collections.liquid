<div class="page-width">
  <div class="page-header">
    <h1>{{ section.settings.heading | escape }}</h1>
  </div>
  <div class="grid grid--3 page-content">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        <a href="{{ collection.url }}" class="collection-card reveal">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 50vw' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="collection-card__label">
            <h3>{{ collection.title | escape }}</h3>
            <span>{{ 'collections.products_count' | t: count: collection.products_count }}</span>
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ]
}
{% endschema %}
