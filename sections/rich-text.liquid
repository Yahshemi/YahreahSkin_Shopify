<section class="section{% if section.settings.style == 'surface' %} section--surface{% elsif section.settings.style == 'dark' %} section--dark{% endif %}">
  <div class="page-width">
    <div class="rich-text reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte{% unless section.settings.style == 'dark' %} subtle{% endunless %}">{{ section.settings.text }}</div>{%- endif -%}

      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', id: section.id, class: 'newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" style="width:100%">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}<p class="form-message form-message--error" style="width:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
            <label for="Email-{{ section.id }}" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
            <input id="Email-{{ section.id }}" class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
            <button type="submit" class="button button--primary">{{ 'newsletter.subscribe' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      {%- elsif section.settings.button_label != blank -%}
        <div class="hero__buttons">
          <a href="{{ section.settings.button_link }}" class="button {% if section.settings.style == 'dark' %}button--light{% else %}button--primary{% endif %}">{{ section.settings.button_label | escape }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text / email signup",
  "settings": [
    {
      "type": "select", "id": "style", "label": "Background", "default": "plain",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "surface", "label": "Alabaster" },
        { "value": "dark", "label": "Deep forest" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Join the ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Skin tips that skip the fluff" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Get routines, ingredient breakdowns and early access to new launches.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label (when signup is off)" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text / email signup" }]
}
{% endschema %}
