<div class="customer">
  <h1>{{ 'customer.register' | t }}</h1>
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input class="input" id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></div>
    <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input class="input" id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></div>
    <div class="field"><label for="RegEmail">{{ 'customer.email' | t }}</label><input class="input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required value="{{ form.email }}"></div>
    <div class="field"><label for="RegPassword">{{ 'customer.password' | t }}</label><input class="input" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button type="submit" class="button button--primary button--full">{{ 'customer.register' | t }}</button>
  {%- endform -%}
  <div class="customer__links"><a href="{{ routes.account_login_url }}" class="link">{{ 'customer.login' | t }}</a></div>
</div>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
