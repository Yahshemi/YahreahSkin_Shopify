<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="image-text{% if section.settings.image_right %} image-text--reverse{% endif %}">
      <div class="image-text__media reveal">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte subtle">{{ section.settings.text }}</div>{%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="pillars">
            {%- for block in section.blocks -%}
              <div class="pillar" {{ block.shopify_attributes }}>
                <span class="pillar__num">{{ forloop.index | prepend: '0' }}</span>
                <div>
                  <h3>{{ block.settings.title | escape }}</h3>
                  <p>{{ block.settings.text | escape }}</p>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--secondary" style="margin-top:2rem">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Alabaster background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our ethos" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "True beauty radiates from within" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Yahreah Skin pairs clean, USA-made supplements with barrier-first topicals so your routine supports your skin from both sides. No fluff. Just ingredients that earn their place.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Transparent formulas" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every ingredient and amount listed. Nothing hidden in a proprietary blend." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Mission", "text": "Curated supplements and serums made to support skin health and everyday well-being." } },
        { "type": "pillar", "settings": { "title": "Standards", "text": "USA-made formulas with transparent, high-quality ingredients." } },
        { "type": "pillar", "settings": { "title": "Purpose", "text": "Help you nurture your inner vitality, because healthy skin starts within." } }
      ]
    }
  ]
}
{% endschema %}
