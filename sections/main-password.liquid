<div class="page-width page-width--narrow text-center" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:4rem 1.25rem">
  <span class="site-header__logo-text" style="font-size:2.25rem">{{ shop.name }}</span>
  <h1 class="h2" style="margin-top:2rem">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p class="subtle">{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer', class: 'newsletter-form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" style="width:100%">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
      <input id="PasswordNewsletter" class="input" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}">
      <button type="submit" class="button button--primary">{{ 'newsletter.subscribe' | t }}</button>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top:3rem">
    <summary class="link" style="cursor:pointer">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password', class: 'newsletter-form' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" style="width:100%">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
      <input id="StorePassword" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
      <button type="submit" class="button">{{ 'password.submit' | t }}</button>
    {%- endform -%}
    <p class="subtle" style="font-size:.8125rem;margin-top:1rem">{{ 'password.owner' | t }} <a class="link" href="/admin">{{ 'password.login' | t }}</a></p>
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Something good is coming" }]
}
{% endschema %}
